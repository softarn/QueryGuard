		"drizzle-kit": "^0.31.9",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@tailwindcss/vite": "^4.2.1",
		"better-sqlite3": "^12.6.2",
